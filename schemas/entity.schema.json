{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lod-rules/schemas/entity.schema.json",
  "title": "Source-backed catalogue entities",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "section_id",
      "source",
      "status",
      "confidence",
      "source_text",
      "type",
      "rules",
      "tables"
    ],
    "properties": {
      "id": {
        "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "section_id": {
        "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
      },
      "source": {
        "type": "array",
        "items": {
          "$ref": "https://lod-rules/schemas/mechanics.schema.json#/$defs/source"
        },
        "minItems": 1
      },
      "status": {
        "enum": ["extracted", "reviewed"]
      },
      "confidence": {
        "enum": ["high", "medium", "low"]
      },
      "source_text": {
        "type": "string",
        "minLength": 1
      },
      "see_also": {
        "type": "array",
        "items": {
          "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
        },
        "minItems": 0
      },
      "unresolved_references": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 0
      },
      "issues": {
        "type": "array",
        "items": {
          "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
        },
        "minItems": 0
      },
      "type": {
        "enum": ["profession", "talent", "condition", "species", "background", "quest", "perk"]
      },
      "rules": {
        "type": "array",
        "items": {
          "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
        },
        "minItems": 0
      },
      "tables": {
        "type": "array",
        "items": {
          "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
        },
        "minItems": 0
      },
      "grants": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label", "printed_reference"],
          "properties": {
            "kind": {
              "enum": ["talent", "perk"]
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "object_id": {
              "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
            },
            "section_id": {
              "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
            },
            "printed_reference": {
              "type": "string",
              "minLength": 1
            },
            "qualifier": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "minItems": 0
      },
      "starting_equipment": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "quantity", "selection"],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "selection": {
              "enum": ["fixed", "choice", "random"]
            },
            "qualifier": {
              "type": "string",
              "minLength": 1
            },
            "object_id": {
              "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
            },
            "section_id": {
              "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label"],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "object_id": {
                    "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
                  }
                }
              }
            }
          }
        },
        "minItems": 0
      },
      "activation": {
        "enum": ["passive", "active"]
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "table_rows": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["table_id", "row_id"],
          "properties": {
            "table_id": {
              "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
            },
            "row_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      },
      "initial_hit_points": {
        "type": "object",
        "additionalProperties": false,
        "required": ["printed", "dice"],
        "properties": {
          "printed": {
            "type": "string",
            "minLength": 1
          },
          "dice": {
            "$ref": "https://lod-rules/schemas/mechanics.schema.json#/$defs/dice"
          }
        }
      },
      "talent_selection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["selection", "category_selection", "quantity"],
        "properties": {
          "selection": {
            "const": "random"
          },
          "category_selection": {
            "const": "choice"
          },
          "quantity": {
            "const": 1
          }
        }
      },
      "grant_choices": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quantity", "options"],
          "properties": {
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "label", "printed_reference"],
                "properties": {
                  "kind": {
                    "enum": ["talent", "perk"]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "object_id": {
                    "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
                  },
                  "section_id": {
                    "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
                  },
                  "printed_reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "qualifier": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "starting_abilities": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "selection", "quantity", "section_id", "printed_reference"],
          "properties": {
            "kind": {
              "enum": ["spell", "prayer", "perk"]
            },
            "selection": {
              "const": "choice"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "level": {
              "type": "integer",
              "minimum": 1
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "section_id": {
              "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
            },
            "printed_reference": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "background_number": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      },
      "quest_id": {
        "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id"
      },
      "activation_cost": {
        "type": "object",
        "additionalProperties": false,
        "required": ["energy", "action_points"],
        "properties": {
          "energy": {
            "type": "integer",
            "minimum": 1
          },
          "action_points": {
            "type": "integer",
            "minimum": 0
          },
          "energy_selection": {
            "enum": ["fixed", "variable"]
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "profession"
            }
          }
        },
        "then": {
          "required": ["grants", "starting_equipment"],
          "properties": {
            "grants": {},
            "starting_equipment": {}
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "species"
            }
          }
        },
        "then": {
          "required": ["initial_hit_points", "table_rows", "grants"],
          "properties": {
            "initial_hit_points": {},
            "table_rows": {},
            "grants": {}
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "not": {
                "const": "species"
              }
            }
          }
        },
        "then": {
          "properties": {
            "initial_hit_points": false,
            "talent_selection": false
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "background"
            }
          }
        },
        "then": {
          "required": ["background_number"],
          "properties": {
            "background_number": {}
          }
        },
        "else": {
          "properties": {
            "background_number": false
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "perk"
            }
          }
        },
        "then": {
          "required": ["category", "activation", "activation_cost"],
          "properties": {
            "activation": {
              "const": "active"
            },
            "category": {},
            "activation_cost": {}
          }
        },
        "else": {
          "properties": {
            "activation_cost": false
          }
        }
      }
    ]
  }
}
