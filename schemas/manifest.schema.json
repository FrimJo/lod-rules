{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lod-rules/schemas/manifest.schema.json",
  "title": "Source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["documents"],
  "properties": {
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "file", "canonical"],
        "properties": {
          "id": { "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "edition": { "type": "string" },
          "language": { "type": "string" },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Path relative to the source/ directory."
          },
          "canonical": { "type": "boolean" },
          "source_class": {
            "enum": [
              "rulebook",
              "official_errata",
              "official_faq",
              "supplement",
              "house_rule",
              "community_interpretation"
            ]
          }
        }
      }
    },
    "external_sources": {
      "type": "array",
      "description": "Books the rulebook depends on that are not part of this repository.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id" },
          "title": { "type": "string" },
          "status": { "enum": ["not_present", "present"] },
          "file": { "type": "string" }
        }
      }
    }
  }
}
