{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lod-rules/schemas/source-reference.schema.json",
  "title": "Source reference",
  "description": "Provenance for a single extracted fact. Every mechanically meaningful object carries at least one.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document"],
  "properties": {
    "document": {
      "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/id",
      "description": "Document id declared in source/manifest.yaml."
    },
    "file": {
      "type": "string",
      "description": "Path to the source file, relative to the repository root."
    },
    "printed_page": {
      "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/printedPage"
    },
    "pdf_page": {
      "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/pdfPage"
    },
    "section": {
      "type": ["string", "null"]
    },
    "heading": {
      "type": ["string", "null"]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paragraph": { "type": ["integer", "string", "null"] },
        "table": { "type": ["string", "null"] },
        "row": { "type": ["integer", "string", "null"] },
        "column": { "type": ["integer", "string", "null"] },
        "region": { "type": ["string", "null"] }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/extractionMethod"
        },
        "confidence": {
          "oneOf": [
            { "$ref": "https://lod-rules/schemas/common.schema.json#/$defs/confidence" },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ]
        },
        "visually_verified": { "type": "boolean" }
      }
    }
  }
}
