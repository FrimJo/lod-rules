{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lod-rules/schemas/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$",
      "description": "Stable, lowercase, dot-separated semantic identifier. Must not encode page numbers."
    },
    "confidence": {
      "enum": ["high", "medium", "low"]
    },
    "coverageStatus": {
      "enum": ["not_started", "mapped", "extracting", "extracted", "reviewed"]
    },
    "componentCoverageStatus": {
      "enum": ["not_started", "mapped", "extracting", "extracted", "reviewed", "not_applicable"]
    },
    "extractionMethod": {
      "enum": ["text", "table", "image", "ocr", "manual"]
    },
    "printedPage": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Page label as printed in the rulebook. Null when not yet known."
    },
    "pdfPage": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Physical 1-based page index in the PDF. Null when not yet known."
    }
  }
}
