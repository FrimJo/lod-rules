{
  "name": "lod-rules-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web client that answers League of Dungeoneers rules questions from the lod-rules corpus",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "bundle": "node --import tsx build/bundle-data.ts",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@tanstack/ai": "^0.63.0",
    "@tanstack/ai-openai": "^0.25.1",
    "@tanstack/ai-react": "^0.29.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "nitro": "^3.0.260903-beta",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
