# Read from the process environment, then from the corpus repo's .env.local.
# OpenRouter key (sk-or-...). Answers go through OpenRouter's OpenAI-compatible endpoint.
OPENAI_ROUTER_API_KEY=
# An OpenRouter model id (provider/model), e.g. openai/gpt-6.1-sol.
OPENAI_ROUTER_MODEL=openai/gpt-6-luna
# Default retrieval mode: jev_filtered (Jev adds records, then drops irrelevant ones), jev,
# lexical, laya (local ONNX) or cascade (Laya first; Jev answers only what Laya is unsure of).
# Unset, it is jev_filtered when TYPESAFE_API_KEY is set and lexical otherwise. Each browser
# can override it in the retrieval settings dialog. A Jev mode falls back to lexical without a key.
LOD_ANALYZER=jev_filtered
# Enables the Jev modes.
TYPESAFE_API_KEY=
