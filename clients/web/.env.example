# Read from the process environment, then from the corpus repo's .env.local.
OPENAI_API_KEY=
# Any model id supported by @tanstack/ai-openai.
OPENAI_MODEL=gpt-5.5
# Default retrieval mode: lexical (default), laya (local ONNX), jev (needs TYPESAFE_API_KEY)
# or cascade (Laya first; Jev answers only what Laya is unsure of). Each browser can override
# it in the retrieval settings dialog. A Jev mode falls back to lexical when no key is set.
LOD_ANALYZER=lexical
# Enables the Lexical + Jev and Lexical + Laya + Jev modes.
TYPESAFE_API_KEY=
