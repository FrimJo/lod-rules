# Read from the process environment, then from the corpus repo's .env.local.
# OpenRouter key (sk-or-...). Answers go through OpenRouter's OpenAI-compatible endpoint.
OPENAI_ROUTER_API_KEY=
# An OpenRouter model id (provider/model), e.g. openai/gpt-6.1-sol.
OPENAI_ROUTER_MODEL=openai/gpt-6-luna
# Default retrieval mode: jev (Jev adds records to lexical search), jev_filtered (then drops
# records Jev judges irrelevant; opt-in until the filter is calibrated) or lexical. Unset, it is
# jev when TYPESAFE_API_KEY is set and lexical otherwise. Each browser can override it in the
# retrieval settings dialog. A Jev mode falls back to lexical without a key.
LOD_ANALYZER=jev
# Enables the Jev modes.
TYPESAFE_API_KEY=
# Shared password for a test deployment. Set, every page and API call needs a sign-in at
# /login; unset (as in dev), the site is open.
ACCESS_PASSWORD=
# Data bundle the server reads instead of the repo checkout. The production build finds the
# bundle next to the server on its own; set this only to point a server elsewhere.
LOD_DATA_DIR=
