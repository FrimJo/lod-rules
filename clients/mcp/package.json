{
  "name": "lod-rules-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing the lod-rules retrieval tools to Claude agents",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "lod-rules-mcp": "bin/lod-rules-mcp.mjs"
  },
  "scripts": {
    "start": "node bin/lod-rules-mcp.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node bin/lod-rules-mcp.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "tsx": "^4.20.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
