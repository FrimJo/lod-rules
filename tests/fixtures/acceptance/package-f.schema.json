{
  "type": "object",
  "additionalProperties": false,
  "required": ["package", "status", "inventory", "entries"],
  "properties": {
    "package": {
      "const": "F"
    },
    "status": {
      "enum": ["open", "accepted"]
    },
    "inventory": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "disposition",
          "scope",
          "canonical_object_ids",
          "evidence",
          "source_limitations",
          "remaining_work",
          "notes",
          "source",
          "obligations"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "implemented",
              "covered_by_another_model",
              "nonprocedural",
              "source_limitation",
              "catalogue_scope",
              "pending"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "canonical_object_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "remaining_work": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "shared_lifecycle_rows": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "deferred_work": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["document", "file", "pdf_page", "printed_page", "heading"],
              "properties": {
                "document": {
                  "const": "rulebook.second_printing.eng"
                },
                "file": {
                  "const": "source/Rulebook-2nd-printing-ENGa.pdf"
                },
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 286
                },
                "printed_page": {
                  "type": ["integer", "null"]
                },
                "heading": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "obligations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "behavior",
                "disposition",
                "canonical_object_ids",
                "tests",
                "source",
                "shared_behavior",
                "limitations",
                "remaining_work"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "behavior": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "enum": [
                    "implemented",
                    "shared_model",
                    "nonprocedural",
                    "source_limitation",
                    "catalogue_scope",
                    "pending"
                  ]
                },
                "canonical_object_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "tests": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["file", "name"],
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "source": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["document", "file", "pdf_page", "printed_page", "heading"],
                    "properties": {
                      "document": {
                        "const": "rulebook.second_printing.eng"
                      },
                      "file": {
                        "const": "source/Rulebook-2nd-printing-ENGa.pdf"
                      },
                      "pdf_page": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 286
                      },
                      "printed_page": {
                        "type": ["integer", "null"]
                      },
                      "heading": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "shared_behavior": {
                  "type": "string"
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["fact", "review_id"],
                    "properties": {
                      "fact": {
                        "type": "string",
                        "minLength": 1
                      },
                      "review_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "remaining_work": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
